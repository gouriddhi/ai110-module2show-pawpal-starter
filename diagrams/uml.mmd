classDiagram
    %% PawPal+ working UML draft — update in Phase 6 to match the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +time day_end
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +set_availability(minutes: int, start: time, end: time) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~str~ special_needs
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(task_id: str, changes: dict) None
        +remove_task(task_id: str) None
        +complete_task(task_id: str, day: date) Task
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str description
        +str category
        +time scheduled_time
        +str preferred_time
        +str frequency
        +bool completed
        +date last_completed
        +date due_date
        +str pet_name
        +str task_id
        +mark_complete(day: date) None
        +priority_value() int
        +is_due_today(day: date) bool
        +next_occurrence() Task
        +update(changes: dict) None
    }

    class Scheduler {
        +Owner owner
        +list~dict~ plan
        +list~tuple~ skipped
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~, day: date) list~Task~
        +assign_time_slots(tasks: list~Task~) list~dict~
        +detect_conflicts() list~tuple~
        +conflict_warnings() list~str~
        +mark_task_complete(task: Task, day: date) Task
        +generate_plan(day: date) list~dict~
        +explain_choice(task: Task) str
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler "1" ..> "0..*" Task : schedules
